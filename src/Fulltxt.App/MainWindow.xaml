<Window x:Class="Fulltxt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Fulltxt.Core.Models;assembly=Fulltxt.Core"
        xmlns:vm="clr-namespace:Fulltxt.App.ViewModels"
        xmlns:ctl="clr-namespace:Fulltxt.App.Controls"
        Title="FullTXT" Icon="Assets/icon.png"
        Width="1120" Height="720" MinWidth="780" MinHeight="480"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Suchzeile über die volle Breite (wie die Navigationsleiste der Website) -->
        <Border Grid.Row="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Height="64">
            <Border Margin="20,10" CornerRadius="10" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,12,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Alle Dateien durchsuchen …" FontSize="18" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuery}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Suche leeren (Esc)" AutomationProperties.Name="Suche leeren"
                            Command="{Binding ClearSearchCommand}" Margin="0,0,6,0"
                            Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="220"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Links (1/4): verknüpfte Ordner und Konten -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
                        <Button Style="{StaticResource FlatButton}" Command="{Binding OpenSettingsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip="Einstellungen"
                                AutomationProperties.Name="Einstellungen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Einstellungen" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="20,16,12,10">
                        <TextBlock Text="QUELLEN" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                Width="28" Height="28" FontSize="13" ToolTip="Alle neu indexieren" AutomationProperties.Name="Alle neu indexieren"
                                Command="{Binding ReindexAllCommand}"/>
                    </Grid>

                    <Grid>
                        <ListBox ItemsSource="{Binding Sources}" ItemContainerStyle="{StaticResource SourceListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                                    <Grid x:Name="Row" Background="Transparent" ToolTip="{Binding SubText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"
                                                       ToolTip="{Binding Details}"/>
                                        </StackPanel>
                                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Vertical" Opacity="0" Margin="4,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Width="26" Height="26" FontSize="12"
                                                    ToolTip="Neu indexieren" AutomationProperties.Name="Neu indexieren"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding DataContext.ReindexSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Noch keine Ordner oder Konten verknüpft." TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="24,32" VerticalAlignment="Top"
                                   Visibility="{Binding HasNoSources, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Rechts (3/4): Suchergebnisse -->
            <Grid Grid.Column="1">
                <Rectangle Height="360" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{DynamicResource GlowBrush}"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,16,24,10">
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding NoticeText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right" MaxWidth="560" ToolTip="{Binding NoticeText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="SearchResultsList" Grid.Row="1" ItemsSource="{Binding SearchResults}"
                             MouseDoubleClick="SearchResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SearchHit}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding FileName, Converter={StaticResource FileIcon}}"
                                           Width="32" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorder}" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding SourceDisplayName}" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,8"/>
                                        <ctl:HighlightedTextBlock MarkedText="{Binding Snippet}" TextWrapping="Wrap" LineHeight="20"
                                                                  Foreground="{DynamicResource TextMutedBrush}"/>

                                        <!-- Aktionen: Cloud = gezielt laden oder im Browser ansehen, lokal = öffnen -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCloud}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Im Browser öffnen" Style="{StaticResource ResultAction}"
                                                    Visibility="{Binding HasWebUrl, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Herunterladen" Style="{StaticResource ResultAction}"
                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCloud}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Öffnen" Style="{StaticResource ResultAction}"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Im Ordner zeigen" Style="{StaticResource ResultAction}"
                                                    Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Leerzustand im Stil des Hero-Bereichs der Website -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                                Margin="24,0,24,60" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <Border Width="88" Height="88" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                            </Border.Effect>
                            <Image Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,88,88" RadiusX="20" RadiusY="20"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="24" FontWeight="ExtraBold"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,8"/>
                        <TextBlock Text="{Binding EmptyStateText}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" LineHeight="22"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
