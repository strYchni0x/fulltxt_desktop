<Window x:Class="Fulltxt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fulltxt.App.ViewModels"
        xmlns:conv="clr-namespace:Fulltxt.App.Converters"
        Title="FullTXT für Windows" Height="640" Width="980" MinHeight="480" MinWidth="700">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Spalte: Quellen -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Quellen" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="+ Lokalen Ordner hinzufügen" Command="{Binding AddLocalFolderCommand}" Margin="0,0,0,4"/>
                <Button Content="+ Nextcloud-Verbindung hinzufügen" Command="{Binding AddNextcloudCommand}" Margin="0,0,0,4"/>
                <Button Content="Alle neu indexieren" Command="{Binding ReindexAllCommand}"/>
            </StackPanel>

            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Sources}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,6">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                    <Run Text=" Dateien"/>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#2E7D32" Margin="0,2,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Neu indexieren" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                            Command="{Binding DataContext.ReindexSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Entfernen" FontSize="11" Padding="6,2"
                                            Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Rechte Spalte: Suche -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Volltextsuche" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <TextBox DockPanel.Dock="Top" FontSize="16" Padding="6"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,6,0,6"/>

            <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}" BorderThickness="0"
                     MouseDoubleClick="SearchResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" — " Foreground="Gray"/>
                                    <TextBlock Text="{Binding SourceDisplayName}" Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
