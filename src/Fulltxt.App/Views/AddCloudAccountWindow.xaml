<Window x:Class="Fulltxt.App.Views.AddCloudAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cloud="clr-namespace:Fulltxt.Core.Cloud;assembly=Fulltxt.Core"
        Title="Cloud-Konto hinzufügen" Icon="../Assets/icon.png"
        Width="540" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="28,22,28,24">
        <!-- Schritt 1: Anbieter wählen -->
        <StackPanel x:Name="ChooserPanel">
            <TextBlock Text="Cloud-Konto hinzufügen" FontSize="22" FontWeight="ExtraBold" Margin="0,0,0,4"/>
            <TextBlock Text="Deine Dateien bleiben in der Cloud. FullTXT liest sie einmal, speichert nur den durchsuchbaren Text verschlüsselt auf diesem Rechner und lädt später nur die Datei, die du wirklich brauchst."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <ItemsControl x:Name="ProviderList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type cloud:CloudProviderInfo}">
                        <Button Click="Provider_Click" Margin="0,0,8,8" Padding="14,12" HorizontalContentAlignment="Stretch"
                                Background="{DynamicResource SurfaceAltBrush}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Abbrechen" IsCancel="True" HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Schritt 2: Zugangsdaten bzw. Anmeldung -->
        <StackPanel x:Name="FormPanel" Visibility="Collapsed">
            <TextBlock x:Name="FormTitle" FontSize="22" FontWeight="ExtraBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="FormIntro" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel x:Name="PasswordFields">
                <TextBlock Text="Anzeigename" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="DisplayNameBox" Margin="0,0,0,12"/>

                <StackPanel x:Name="ServerRow">
                    <TextBlock Text="Server-Adresse (z.B. https://cloud.example.com)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ServerUrlBox" Margin="0,0,0,12"/>
                </StackPanel>

                <TextBlock x:Name="UsernameLabel" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>

                <TextBlock x:Name="SecretLabel" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="SecretBox" Margin="0,0,0,12"/>

                <TextBlock Text="Startordner (optional, Standard: alles)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="StartFolderBox" Text="/" Margin="0,0,0,12"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zurück" Click="Back_Click" Margin="0,0,8,0"/>
                <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Click="Action_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
