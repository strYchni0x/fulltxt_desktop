<Window x:Class="Fulltxt.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fulltxt.App.ViewModels"
        Title="Einstellungen" Icon="../Assets/icon.png"
        Width="580" Height="680" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <DockPanel Margin="28,22,28,20">
        <TextBlock DockPanel.Dock="Top" Text="Einstellungen" FontSize="24" FontWeight="ExtraBold"/>

        <Button DockPanel.Dock="Bottom" Content="Schließen" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Margin="0,16,0,0" MinWidth="110"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="QUELLEN" Style="{StaticResource SectionTitle}"/>

                <ListBox ItemsSource="{Binding Sources}" ItemContainerStyle="{StaticResource SourceListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="-12,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="False">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorder}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding SubText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Neu indexieren" AutomationProperties.Name="Neu indexieren"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Command="{Binding DataContext.ReindexSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Quelle entfernen" AutomationProperties.Name="Quelle entfernen"
                                            Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Noch keine Ordner oder Konten verknüpft." Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,10" Visibility="{Binding HasNoSources, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Ordner hinzufügen" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddLocalFolderCommand}" Margin="0,0,10,0"/>
                    <Button Content="+ Cloud-Konto hinzufügen" Command="{Binding AddCloudAccountCommand}"/>
                </StackPanel>

                <TextBlock Text="DARSTELLUNG" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="System" GroupName="Theme"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=System}"/>
                    <RadioButton Content="Hell" GroupName="Theme"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"/>
                    <RadioButton Content="Dunkel" GroupName="Theme"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"/>
                </StackPanel>

                <TextBlock Text="DATENSCHUTZ" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="✓  Alles bleibt lokal auf diesem Rechner" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="✓  Cloud-Dateien werden nur gelesen, nicht gespeichert – lokal liegt nur der Textindex" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="✓  Der Suchindex ist verschlüsselt (SQLCipher)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="✓  Der Schlüssel ist an dein Windows-Konto gebunden" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="✓  Keine Telemetrie, keine Server von uns" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
