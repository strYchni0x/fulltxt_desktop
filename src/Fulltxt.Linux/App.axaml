<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fulltxt.Linux.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://fulltxt/Themes/Styles.axaml"/>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://fulltxt/Themes/Palette.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
