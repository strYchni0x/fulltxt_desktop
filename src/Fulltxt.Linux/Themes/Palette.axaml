<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- Palette 1:1 von fulltxt.me (:root) -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgBrush" Color="#0C0C0C"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#161616"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#242424"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#22C55E"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#16A34A"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A2E"/>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#6622C55E"/>
            <SolidColorBrush x:Key="HighlightBrush" Color="#4022C55E"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
            <RadialGradientBrush x:Key="GlowBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="75%" RadiusY="45%">
                <GradientStop Color="#2022C55E" Offset="0"/>
                <GradientStop Color="#0022C55E" Offset="1"/>
            </RadialGradientBrush>
        </ResourceDictionary>

        <!-- Helle Variante: gleiche Grüntöne (primary-dark als Akzent für Kontrast) -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgBrush" Color="#F4F5F4"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#EEF1EE"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#E0E3E0"/>
            <SolidColorBrush x:Key="TextBrush" Color="#0C0C0C"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#666666"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#16A34A"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#15803D"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3F6EA"/>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#8016A34A"/>
            <SolidColorBrush x:Key="HighlightBrush" Color="#BDEBCB"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
            <RadialGradientBrush x:Key="GlowBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="75%" RadiusY="45%">
                <GradientStop Color="#2016A34A" Offset="0"/>
                <GradientStop Color="#0016A34A" Offset="1"/>
            </RadialGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

